# Directory Index specification for Hostinger LiteSpeed / Apache
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Prevent directory browsing while allowing symlinks
  Options -Indexes +FollowSymLinks

  # Directly execute Hostinger PHP MySQL API
  RewriteRule ^api/db$ /api/db.php [L,QSA]
  RewriteRule ^api/db\.php$ - [L]

  # Dynamic live sitemaps for Google Search Engine crawlers
  RewriteRule ^sitemap-routes\.xml$ /sitemap-routes.php [L]

  # Dynamic Edge SEO & Meta injection for route landing pages (Googlebot & Users)
  RewriteRule ^taxi/([a-zA-Z0-9\-_]+)/?$ /route-seo.php?slug=$1 [L,QSA]

  # Allow direct access to real existing files and directories
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA Routing Fallback to index.html for all other routes
  RewriteRule ^ /index.html [L]
</IfModule>
